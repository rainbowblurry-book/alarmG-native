{
  "expo": {
    "name": "ClockGuard",
    "slug": "ClockGuard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#162748"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
   },
    "android": {
      "package": "com.rainbowblurry.wakeupnative",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "ClockGuard needs camera access to scan your registered wake-up item barcode."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "97476ed3-a6a3-401d-aa11-362b5df2638d"
      }
    },
    "owner": "rainbowblurrys-team"
  }
}
